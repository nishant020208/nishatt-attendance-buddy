# Supabase Configuration
# Required for connecting the frontend to your Supabase project
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Note: VITE_SUPABASE_ANON_KEY is also accepted as an alias
# VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Supabase Edge Functions Configuration (Set these in Supabase Dashboard -> Edge Functions -> Secrets)
# AI_API_KEY=sk-proj-...
# OPENAI_API_KEY=sk-proj-...
# AI_GATEWAY_URL=https://api.openai.com/v1/chat/completions
# AI_MODEL=gpt-4o-mini
# AI_VISION_MODEL=gpt-4o
